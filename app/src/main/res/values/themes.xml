<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base application theme. NoActionBar on purpose: targetSdk 36 means edge-to-edge is
        enforced on Android 15+, and a decor ActionBar ends up floating over content that
        lays out behind it. Each screen puts a real Toolbar in its own layout instead, so
        the bar occupies real space and cannot overlap or leak touches.
    -->
    <style name="Theme.SpeedMeter" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
